
# Migration preservation and private inputs: never publish.
/local/
/var/
/.env
__pycache__/
*.pyc
*.jks
*.keystore


# Raw captures need content review before publication.
/sources/community/raw/
/sources/observations/


# Runtime logs are private and regenerated.
*.log
/logs/

# Scratch work products and OCR intermediates — regenerated, never published.
findings/**/_tmp*
findings/**/_*ocr.json

# Heavy raw captures (video/frames) live in local/findings-media/ preservation
# storage, not in git. Evidence text (TSV/MD/JSON reports) is what gets published.
findings/**/*.mp4
findings/**/*.jpg
findings/**/*.jpeg
findings/**/*.bin
